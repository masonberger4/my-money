# Copy to .env.local for local dev. On Vercel, set these in Project Settings →
# Environment Variables (VITE_* vars must be present at build time).

# ---- Client (safe to expose; anon key is public by design) -------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---- Server only (never exposed to the browser) ------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Plaid credentials, in fill order. When one account's Items are used up,
# create another Plaid developer account and append it here — new links
# route to the first entry with a free slot automatically.
PLAID_CREDENTIALS=[{"key":"main","client_id":"YOUR_CLIENT_ID","secret":"YOUR_SECRET"}]
PLAID_ENV=production

# Optional: free-tier Item limit per credential (default 10)
# PLAID_MAX_ITEMS_PER_CREDENTIAL=10
