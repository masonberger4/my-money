# Copy to .env.local for local dev. On Vercel, set these in Project Settings →
# Environment Variables (VITE_* vars must be present at build time).

# ---- Client (safe to expose; anon key is public by design) -------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---- Server only (never exposed to the browser) ------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# PLAID_CREDENTIALS / PLAID_ENV / PLAID_MAX_ITEMS_PER_CREDENTIAL used to live
# here. Plaid was removed entirely — delete those five variables from Vercel
# (Production AND Preview) once the deploy that removed it is live. Nothing
# reads them, so leaving them is harmless; removing them stops the next person
# wondering which feed is authoritative.

# ---- SimpleFIN (all optional; the defaults are the intended behavior) --------
# No credentials go here: the SimpleFIN access URL is claimed from a setup token
# in the app (Accounts → ⚡ SimpleFIN) and stored in the simplefin_access table,
# which only service_role can read.
#
# Minutes between pulls. SimpleFIN refreshes bank data about once a day, and the
# dashboard triggers a sync on every load, so this keeps a couple of phones from
# hammering the Bridge. Default 60.
# SIMPLEFIN_MIN_PULL_MINUTES=60
#
# Include pending transactions. OFF by default: SimpleFIN has no "removed"
# signal, so a pending row whose id changes when it posts would be stranded in
# the ledger forever. Default off.
# SIMPLEFIN_INCLUDE_PENDING=1
#
# How far back the FIRST pull reaches, and how much overlap each later pull
# re-requests (banks amend and late-post). Defaults 730 / 30.
# SIMPLEFIN_FIRST_PULL_DAYS=730
# SIMPLEFIN_OVERLAP_DAYS=30

# Claude assistant (Ask tab). Server-side only. Create a key at
# console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-...
